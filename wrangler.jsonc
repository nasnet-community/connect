{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasnet-connect",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
